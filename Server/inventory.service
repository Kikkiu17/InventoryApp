[Unit]
Description=Inventory Server - Gestione componenti
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=kik
WorkingDirectory=/home/kik/inventario
ExecStart=/home/kik/inventario/inventory_server 8443 /home/kik/inventario/inventories --generate-cert
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
